<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="{{ 'true' if not is_https else 'false' }}">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="{{ 'true' if not is_https else 'false' }}">
        <domain includeSubdomains="true">{{ host }}</domain>
    </domain-config>
</network-security-config>
